# Variables de entorno para el proyecto
# Cambiar a true para simular el fin de la cuenta regresiva
SIMULATE_COUNTDOWN_END=false

# Fecha objetivo en formato ISO (12 de mayo de 2025)
TARGET_DATE=2025-05-12T00:00:00

# Nota: Este archivo es solo una referencia.
# Las variables están implementadas directamente en countdown.js
# Para usar este archivo con JavaScript, se necesitaría un script adicional o una herramienta como dotenv.
